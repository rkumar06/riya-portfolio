---
interface Props { kind: 'plant' | 'window' | 'spark'; class?: string; }
const { kind, class: className = '' } = Astro.props;
---
<svg class:list={['sketch', className]} viewBox={kind === 'window' ? '0 0 240 180' : '0 0 100 110'} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
  {kind === 'plant' && <>
    <defs>
      <mask id="leaf-pencil-reveal" maskUnits="userSpaceOnUse" x="15" y="10" width="70" height="68">
        <path class="pencil-reveal" pathLength="1" d="M18 12 82 16 18 20 82 24 18 28 82 32 18 36 82 40 18 44 82 48 18 52 82 56 18 60 82 64 18 68 82 72" fill="none" stroke="white" stroke-width="9" />
      </mask>
      <mask id="pot-pencil-reveal" maskUnits="userSpaceOnUse" x="28" y="72" width="45" height="34">
        <path class="pencil-reveal pencil-reveal-pot" pathLength="1" d="M28 75 72 79 28 83 72 87 28 91 72 95 28 99 72 103" fill="none" stroke="white" stroke-width="9" />
      </mask>
      <pattern id="pencil-green" width="7" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(-28)">
        <path d="m.8 1 .4 5.8M3.1 0l-.5 4.1m.2 1.7.3 2M5.3 2l.4 6.4M6.8 0l-.3 3" stroke="#819b53" stroke-width="1.15" opacity=".65" />
        <path d="m1.6 3-.3 5M4.3 1l.2 5" stroke="#a4b975" stroke-width=".65" opacity=".5" />
      </pattern>
      <pattern id="pencil-clay" width="7" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(24)">
        <path d="m.7 0 .3 6M3 2l-.3 6M5.1 0l.4 4.5m-.1 1.6.2 2M6.6 3l-.2 4" stroke="#c1906d" stroke-width="1.2" opacity=".7" />
        <path d="m1.7 2 .2 5M4.1 0l-.3 3.8" stroke="#d3aa85" stroke-width=".6" opacity=".55" />
      </pattern>
    </defs>
    <path class="plant-color" mask="url(#pot-pencil-reveal)" fill="url(#pencil-clay)" stroke="none" d="M32 77c9 2 27 2 36-1l-5 25c-7 3-18 3-25 0l-6-24Z" />
    <rect width="100" height="110" fill="transparent" stroke="none" />
    <path class="plant-pot" pathLength="1" d="M32 77c9 2 27 2 36-1l-5 25c-7 3-18 3-25 0l-6-24ZM30 75c0-4 39-4 40 0 1 5-40 7-40 0Z" />
    <g class="plant-leaves">
    <path class="plant-color" mask="url(#leaf-pencil-reveal)" fill="url(#pencil-green)" stroke="none" d="M49 59c-17 0-25-12-23-24 14 1 23 10 23 24ZM53 46c-3-18 5-29 17-31 3 13-3 27-17 31ZM50 68c4-15 14-23 26-20-2 13-11 21-26 20Z" />
    <path class="plant-stems" pathLength="1" d="M49 73c-2-19 3-36 8-50M49 59c-17 0-25-12-23-24 14 1 23 10 23 24ZM53 46c-3-18 5-29 17-31 3 13-3 27-17 31ZM50 68c4-15 14-23 26-20-2 13-11 21-26 20Z" />
    <path class="plant-veins" pathLength="1" d="M31 40c6 4 12 10 16 17M64 23c-5 7-8 13-10 21M70 54 52 67" />
    </g>
    <path class="plant-ground" pathLength="1" d="M24 105c14 2 39 3 53 0" />
  </>}
  {kind === 'window' && <>
    <path pathLength="1" d="m74 133 2-108 91-2 2 110M82 128l1-95 76-2 2 97M121 33l-1 94M83 78l77-2M68 136l108-1 3 8-113 1 2-8Z" />
    <path pathLength="1" d="m89 67 14-14 13 9M126 65l15-21 15 15M94 95l12-10M129 108l20-21M138 39c1-5 8-6 10-2 3 7-10 10-10 2Z" />
    <path pathLength="1" d="M42 148c-2-12-2-23 2-36M42 132c-13-1-20-9-18-18 12 0 18 6 18 18ZM44 124c0-12 7-20 15-19 1 11-4 18-15 19ZM43 141c6-10 13-12 20-9-3 8-11 12-20 9ZM32 147l26-1-4 21-17 1-5-21Z" />
    <path pathLength="1" d="m174 155 21-1 1 12-21 1-1-12ZM197 155c10-2 10 10 0 9M179 147c-5-5 3-7 0-12M188 146c-5-5 3-7 0-12M21 173c58-3 141-3 191-2" />
  </>}
  {kind === 'spark' && <>
    <path pathLength="1" d="M48 24c0 19-6 24-22 27 17 1 23 8 25 24 0-18 6-24 23-27-18 0-23-7-26-24ZM77 15l-2 13M70 22l13-1M23 75l-3 11M16 80l12 1" />
  </>}
</svg>
