---
const legs = [
  { x: 35, y: 31, hind: true, far: true, delay: '-.36s' },
  { x: 65, y: 30, hind: false, far: true, delay: '-.54s' },
  { x: 33, y: 32, hind: true, far: false, delay: '0s' },
  { x: 64, y: 31, hind: false, far: false, delay: '-.18s' },
];
---
<div class="tiger-track" aria-hidden="true">
  <div class="tiger-runner">
    <svg class="tiger" viewBox="0 0 104 58" fill="none" stroke="#77604a" stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round">
      <defs>
        <pattern id="tiger-pencil" width="6" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(-28)">
          <path d="m.5 0 .3 5M2.4 2l-.3 5M4.3 0l.4 3.5m0 1.5-.2 2M5.8 2l-.3 4" stroke="#cc914c" stroke-width="1.1" opacity=".8" />
          <path d="m1.4 2 .2 4M3.5 0l-.2 3" stroke="#e2b578" stroke-width=".6" opacity=".7" />
        </pattern>
        <g id="tiger-foreleg">
          <path d="M-3-2C-5 2-3 8-1 12l4-1C4 7 4 1 2-2" fill="url(#tiger-pencil)" />
          <path d="m-3 4 4 1m-3 3 4 1" stroke="#76604b" />
          <g transform="translate(1 11)"><g class="tiger-shin">
            <path d="M-2-1-2 10c0 2 3 3 7 2 2-1 1-3-2-3L2 0" fill="url(#tiger-pencil)" />
            <path d="m-1 5 3 .5m1 5 .2 1" />
          </g></g>
        </g>
        <g id="tiger-hindleg">
          <path d="M-4-3C-8 2-5 7 2 12l4-2C3 6 5 1 2-3" fill="url(#tiger-pencil)" />
          <path d="m-5 2 4 1m-2 3 4 1" stroke="#76604b" />
          <g transform="translate(3 10)"><g class="tiger-shin">
            <path d="M-2 0-5 10c-1 3 3 3 7 2 1-2-1-3-3-3L2 1" fill="url(#tiger-pencil)" />
            <path d="m-3 6 3 1m0 4 .3 1" />
          </g></g>
        </g>
      </defs>
      <g class="tiger-bounce">
        <g class="tiger-tail">
          <path d="M27 29C15 34 13 26 9 22 6 18 3 21 5 24" stroke="#b58a59" stroke-width="3.2" />
          <path d="m20 31-1-2m-5-2 2-1m-7-3 2-1M5 24l-1-2" stroke="#75614c" stroke-width="1.8" />
        </g>
        {legs.filter(leg => leg.far).map(leg => <g transform={`translate(${leg.x} ${leg.y})`} opacity=".5"><g class:list={['tiger-leg', leg.hind ? 'hind' : 'fore']} style={`--phase: ${leg.delay}`}><use href={leg.hind ? '#tiger-hindleg' : '#tiger-foreleg'} /></g></g>)}
        <path d="M25 25c4-9 15-10 25-8 9 1 16-1 22 4l4 10c-6 7-13 8-22 5-8-3-16 2-23-1-6-2-9-5-6-10Z" fill="url(#tiger-pencil)" />
        <path d="m33 18 4 9-5-4m12-6 2 10-4-5m13-4-1 9 4-5m7-2-3 9m-34 0 6 3m17 4 2-5m9 6 3-6" stroke="#75604b" stroke-width="1.6" />
        {legs.filter(leg => !leg.far).map(leg => <g transform={`translate(${leg.x} ${leg.y})`}><g class:list={['tiger-leg', leg.hind ? 'hind' : 'fore']} style={`--phase: ${leg.delay}`}><use href={leg.hind ? '#tiger-hindleg' : '#tiger-foreleg'} /></g></g>)}
        <g class="tiger-head">
          <!-- Broad cheek and short, squared muzzle keep the silhouette feline. -->
          <path d="M70 19c-3-2-4-6-1-7 3-1 5 1 5 4 6-3 13-1 16 3l2 5 3 2-1 6-6 3c-7 2-14-1-17-5l-4-3 3-2Z" fill="url(#tiger-pencil)" />
          <path d="M70 14q-2 1 1 4m7-2 1 5m6-4-1 4m-13 0 5 3-5 1m1 3 5-1-3 4" stroke="#75604b" stroke-width="1.5" />
          <path d="M83 26c3-2 7-2 10 0l-1 6c-3 2-8 2-10-1" stroke="#ad9b7c" stroke-width=".8" />
          <path d="m89 25 5 .5-2 3-3-1Z" fill="#75604b" />
          <path d="m91 28-.5 2m-4 0q2 2 4 0 1 2 3 0M82 28l-5-1m5 3-5 1" stroke-width=".7" />
          <path d="m81 22 4 1-2 1" stroke-width="1.2" />
          <circle cx="84" cy="23" r=".65" fill="#514b40" stroke="none" />
        </g>
      </g>
    </svg>
  </div>
</div>

<style>
  .tiger-track { position: absolute; left: 0; right: 0; top: -42px; height: 42px; pointer-events: none; overflow: hidden; }
  .tiger-runner { width: calc(100% - 76px); height: 42px; animation: tiger-travel 22s linear infinite; }
  .tiger { display: block; width: 76px; height: 42px; overflow: visible; animation: tiger-turn 22s steps(1, end) infinite; }
  .tiger-bounce { animation: tiger-bound 720ms ease-in-out infinite; }
  .tiger-leg { transform-origin: 0 0; animation: tiger-stride 720ms ease-in-out infinite; animation-delay: var(--phase); }
  .tiger-shin { transform-origin: 0 0; animation: tiger-fold 720ms ease-in-out infinite; animation-delay: var(--phase, 0s); }
  .tiger-tail { transform-origin: 27px 29px; animation: tiger-tail 720ms ease-in-out infinite alternate; }
  .tiger-head { transform-origin: 70px 28px; animation: tiger-nod 720ms ease-in-out infinite; }
  @keyframes tiger-travel { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(100%); } }
  @keyframes tiger-turn { 0%, 100% { transform: scaleX(1); } 50% { transform: scaleX(-1); } }
  @keyframes tiger-bound { 0%, 50%, 100% { transform: translateY(-1px); } 25%, 75% { transform: translateY(-3px); } }
  @keyframes tiger-stride { 0%, 100% { transform: rotate(-32deg); } 45% { transform: rotate(32deg); } 75% { transform: rotate(5deg); } }
  @keyframes tiger-fold { 0%, 100% { transform: rotate(-8deg); } 35% { transform: rotate(8deg); } 70% { transform: rotate(-55deg); } }
  @keyframes tiger-tail { from { transform: rotate(-6deg); } to { transform: rotate(7deg); } }
  @keyframes tiger-nod { 0%, 50%, 100% { transform: rotate(0); } 25%, 75% { transform: rotate(-2deg); } }
  @media (prefers-reduced-motion: reduce) {
    .tiger-runner, .tiger, .tiger-bounce, .tiger-leg, .tiger-shin, .tiger-tail, .tiger-head { animation: none; }
  }
  @media print { .tiger-track { display: none; } }
</style>
