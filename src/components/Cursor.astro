<div class="custom-cursor" aria-hidden="true">
  <span>
    <svg viewBox="0 0 32 32" fill="none">
      <path class="cursor-loop" pathLength="1" d="M23.8 5.6C18.1 1.8 9.7 4.1 5.8 10.3C1.5 17.2 5.5 26.4 12.7 28C20.8 30.1 28.2 23.9 28 16.2C27.9 10.2 23.5 5.2 17.8 4.4" />
      <path class="cursor-pencil" pathLength="1" d="M8.3 7.7C3.5 12.3 3.7 20.1 8.6 24.3C14.1 29.1 22.7 26.9 26.2 20.7" />
      <circle cx="16" cy="16" r="1" fill="white" />
    </svg>
  </span>
</div>
<style is:global>
  .custom-cursor { display: none; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    html.has-custom-cursor, html.has-custom-cursor * { cursor: none !important; }
    .custom-cursor { display: block; position: fixed; top: 0; left: 0; z-index: 100; pointer-events: none; mix-blend-mode: difference; opacity: 0; }
    .has-custom-cursor .custom-cursor { opacity: 1; }
    .custom-cursor span { display: block; width: 32px; height: 32px; transform: translate(-50%, -50%); }
    .custom-cursor svg { display: block; width: 100%; height: 100%; transform: scale(.55) rotate(-12deg); transition: transform 360ms cubic-bezier(.22, 1.18, .36, 1), scale 120ms ease-out; }
    .custom-cursor path { stroke: white; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
    .custom-cursor .cursor-loop { stroke-dasharray: 1; stroke-dashoffset: .22; transition: stroke-dashoffset 320ms cubic-bezier(.22, 1, .36, 1); }
    .custom-cursor .cursor-pencil { opacity: .15; stroke-width: .65; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 420ms cubic-bezier(.22, 1, .36, 1), opacity 180ms ease-out; }
    .custom-cursor.is-interactive .cursor-loop { stroke-dashoffset: 0; }
    .custom-cursor.is-interactive .cursor-pencil { stroke-dashoffset: 0; opacity: .4; }
    .custom-cursor circle { transition: opacity 180ms ease-out; }
    .custom-cursor.is-interactive circle { opacity: .4; }
    .custom-cursor.is-interactive svg { transform: scale(1.08) rotate(16deg); }
    .custom-cursor.is-pressed svg { scale: .96; }
  }
  @media print { .custom-cursor { display: none; } }
</style>
<script>
  const cursor = document.querySelector<HTMLElement>('.custom-cursor');
  const eligible = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  const reset = () => {
    document.documentElement.classList.remove('has-custom-cursor');
    cursor?.classList.remove('is-pressed');
  };
  document.addEventListener('pointermove', (event) => {
    if (!cursor || !eligible.matches || event.pointerType !== 'mouse') { reset(); return; }
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('input, textarea, select, [contenteditable="true"]')) { reset(); return; }
    cursor.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
    cursor.classList.toggle('is-interactive', !!target?.closest('a, button, .intro-plant'));
    document.documentElement.classList.add('has-custom-cursor');
  }, { passive: true });
  document.addEventListener('pointerdown', () => cursor?.classList.add('is-pressed'));
  document.addEventListener('pointerup', () => cursor?.classList.remove('is-pressed'));
  document.documentElement.addEventListener('pointerleave', reset);
  document.addEventListener('keydown', reset);
  window.addEventListener('blur', reset);
  eligible.addEventListener('change', reset);
</script>
